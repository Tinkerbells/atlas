{
  "name": "@atlas/di",
  "version": "1.0.0",
  "description": "Standalone Dependency Injection system extracted from VS Code",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "keywords": [
    "di",
    "dependency-injection",
    "injection",
    "ioc"
  ],
  "license": "MIT",
  "dependencies": {
    "@atlas/shared": "workspace:*"
  },
  "devDependencies": {
    "@atlas/eslint": "workspace:*",
    "eslint": "^9.39.1",
    "typescript": "~5.9.3"
  }
}
