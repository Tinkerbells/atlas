{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "compilerOptions": {
    "composite": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "~/common/*": [
        "src/common/*"
      ],
      "~/renderer/*": [
        "src/renderer/src/*"
      ],
      "#build/ui.css": [
        "./src/renderer/node_modules/.nuxt-ui/ui.css"
      ],
      "#build/ui/*": [
        "./src/renderer/node_modules/.nuxt-ui/ui/*"
      ]
    }
  },
  "include": [
    "src/common/**/*",
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/preload/*.d.ts",
    "src/renderer/auto-imports.d.ts",
    "src/renderer/components.d.ts"
  ]
}
