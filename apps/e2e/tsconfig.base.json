    "strict": true,
    "module": "commonjs",
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "target": "ES2022",
    "typeRoots": ["node_modules/@types"],
    "lib": ["ES2022"]
  },
  "exclude": ["node_modules", "out-tsc"]
}
