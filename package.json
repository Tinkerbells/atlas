{
  "name": "atlas-monorepo",
  "type": "module",
  "version": "1.0.0",
  "description": "Atlas - Cross-platform file manager inspired by VSCode",
  "homepage": "https://github.com/atlas/atlas",
  "author": {
    "name": "Atlas Team"
  },
  "private": true,
  "scripts": {
    "prepare": "husky",
    "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "desktop:start": "pnpm --filter atlas start",
    "desktop:build": "pnpm --filter atlas build",
    "desktop:electron:local": "pnpm --filter atlas electron:local",
    "desktop:electron:build": "pnpm --filter atlas electron:build",
    "desktop:test": "pnpm --filter atlas test",
    "desktop:test:watch": "pnpm --filter atlas test:watch",
    "desktop:lint": "pnpm --filter atlas lint",
    "e2e": "pnpm --filter atlas-e2e test",
    "e2e:show-trace": "pnpm --filter atlas-e2e show-trace"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "conventional-changelog": "7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "engines": {
    "node": ">= 22.12.0 || >= 24.0.0",
    "typescript": ">= 5.8.0 < 5.9.0"
  }
}
