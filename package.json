{
  "name": "atlas",
  "type": "module",
  "version": "1.0.0",
  "description": "Atlas - Cross-platform file manager inspired by VSCode",
  "private": true,
  "main": "entry.mjs",
  "scripts": {
    "prepare": "husky",
    "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest run",
    "dev": "node scripts/dev.mjs",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:shared": "vite build --config vite.shared.config.ts",
    "build:renderer": "vite build --config vite.config.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:shared && npm run build:renderer",
    "compile": "npm run build && electron-builder build --config electron-builder.mjs",
    "compile:mac": "npm run build && electron-builder build --config electron-builder.mjs --mac",
    "compile:win": "npm run build && electron-builder build --config electron-builder.mjs --win",
    "compile:linux": "npm run build && electron-builder build --config electron-builder.mjs --linux"
  },
  "dependencies": {
    "@fontsource-variable/google-sans": "5.2.1",
    "@iconify/vue": "5.0.0",
    "@jsep-plugin/ternary": "^1.1.4",
    "@lucide/vue": "1.8.0",
    "@vscode/ripgrep": "^1.15.9",
    "@vueuse/core": "14.2.1",
    "@vueuse/integrations": "14.2.1",
    "better-sqlite3": "12.9.0",
    "consola": "3.4.2",
    "electron-updater": "6.8.3",
    "fdir": "6.5.0",
    "fuse.js": "7.3.0",
    "jsep": "^1.4.0",
    "reka-ui": "2.9.6",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.0.0",
    "vite-plugin-vuetify": "2.1.3",
    "vue": "^3.5.30",
    "vue-i18n": "11.4.0",
    "vue-router": "5.0.6",
    "vuetify": "4.0.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@chromatic-com/storybook": "^5.1.2",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@nuxt/ui": "^4.0.0",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/vue3-vite": "^10.3.5",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/browser-playwright": "4.1.5",
    "@vitest/coverage-v8": "4.1.5",
    "@vue/tsconfig": "^0.9.0",
    "conventional-changelog": "7.1.1",
    "electron": "41.0.3",
    "electron-builder": "26.8.1",
    "electron-devtools-installer": "4.0.0",
    "electron-rebuild": "3.2.9",
    "eslint": "^9.39.1",
    "eslint-plugin-storybook": "^10.3.5",
    "happy-dom": "^17.4.6",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.7",
    "playwright": "^1.59.1",
    "sass-embedded": "1.99.0",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "8.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.1.5",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": ">= 22.12.0 || >= 24.0.0",
    "typescript": ">= 5.9.0 < 5.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "@vscode/ripgrep",
      "better-sqlite3"
    ]
  }
}
