{
  "name": "atlas-monorepo",
  "type": "module",
  "version": "1.0.0",
  "description": "Atlas - Cross-platform file manager inspired by VSCode",
  "homepage": "https://github.com/atlas/atlas",
  "author": {
    "name": "Atlas Team"
  },
  "private": true,
  "main": "packages/electron-main/entry-point.mjs",
  "scripts": {
    "prepare": "husky",
    "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "desktop:start": "pnpm --filter atlas start",
    "desktop:build": "pnpm --filter atlas build",
    "desktop:electron:local": "pnpm --filter atlas electron:local",
    "desktop:electron:build": "pnpm --filter atlas electron:build",
    "desktop:test": "pnpm --filter atlas test",
    "desktop:test:watch": "pnpm --filter atlas test:watch",
    "desktop:lint": "pnpm --filter atlas lint",
    "vue:dev": "pnpm --filter @atlas/vue-desktop dev",
    "vue:build": "pnpm --filter @atlas/vue-desktop build",
    "electron:setup": "node scripts/ensure-electron.mjs",
    "electron:dev": "node scripts/ensure-electron.mjs && pnpm --filter @atlas/electron-main dev",
    "electron:build": "node scripts/ensure-electron.mjs && pnpm --filter @atlas/vue-desktop build:electron && pnpm run -r --filter './packages/electron-*' build",
    "electron:compile": "pnpm run electron:build && electron-builder build --config electron-builder.mjs",
    "e2e": "pnpm --filter atlas-e2e test",
    "e2e:show-trace": "pnpm --filter atlas-e2e show-trace"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@npmcli/map-workspaces": "5.0.3",
    "conventional-changelog": "7.1.1",
    "electron": "41.0.3",
    "electron-builder": "26.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "engines": {
    "node": ">= 22.12.0 || >= 24.0.0",
    "typescript": ">= 5.8.0 < 5.9.0"
  }
}
