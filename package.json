{
  "name": "atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Atlas - Cross-platform file manager",
  "author": {
    "name": "Atlas Team",
    "email": "daniel.kasatkin.work@gmail.com"
  },
  "homepage": "https://github.com/atlas/atlas",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">= 22.12.0 || >= 24.0.0",
    "typescript": ">= 5.9.0 < 5.10.0"
  },
  "scripts": {
    "prepare": "husky",
    "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild:node": "cd node_modules/better-sqlite3 && npx prebuild-install",
    "rebuild:electron": "cd node_modules/better-sqlite3 && npx prebuild-install --target=41.0.3 --runtime=electron --arch=arm64 --platform=darwin",
    "pretest": "npm run rebuild:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:common": "vitest run src/common",
    "test:main": "vitest run src/main",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "compile": "npm run build && electron-builder",
    "compile:mac": "npm run build && electron-builder --mac",
    "compile:win": "npm run build && electron-builder --win",
    "compile:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "12.10.0",
    "electron-log": "5.4.4",
    "vscode-uri": "3.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@nuxt/ui": "4.8.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.19.1",
    "@unocss/preset-wind4": "66.7.0",
    "@unocss/reset": "66.7.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "@vueuse/core": "14.3.0",
    "conventional-changelog": "7.1.1",
    "electron": "41.0.3",
    "electron-builder": "26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.9.3",
    "unocss": "66.7.0",
    "unocss-preset-nuxt-ui": "4.0.6",
    "vite": "^7.2.6",
    "vitest": "4.1.8",
    "vue": "^3.5.25",
    "vue-tsc": "^3.1.6"
  }
}
