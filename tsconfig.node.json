{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "~/common/*": ["src/common/*"],
      "~/main/*": ["src/main/*"],
      "~/preload/*": ["src/preload/*"]
    },
    "types": [
      "electron-vite/node"
    ]
  },
  "include": [
    "electron.vite.config.*",
    "src/common/**/*",
    "src/main/**/*",
    "src/preload/**/*"
  ]
}
