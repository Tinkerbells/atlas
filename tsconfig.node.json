{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "~/common/*": [
        "src/common/*"
      ],
      "~/main/*": [
        "src/main/*"
      ],
      "~/preload/*": [
        "src/preload/*"
      ],
      "#build/ui": [
        "./node_modules/.nuxt-ui/ui"
      ]
    },
    "types": [
      "electron-vite/node"
    ]
  },
  "include": [
    "electron.vite.config.*",
    "src/common/**/*",
    "src/main/**/*",
    "src/preload/**/*"
  ]
}
